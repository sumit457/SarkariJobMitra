APP_NAME=govjobs
ENV=production
PUBLIC_SITE_PHASE=tools

# Use a long random value in production.
SECRET_KEY=change-this-long-random-secret

# Tools-only phase does not expose job/admin routes, but settings are still required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Comma-separated exact frontend origins.
CORS_ORIGINS=https://your-domain.com,https://your-vercel-project.vercel.app

# Public tool safety limits.
MAX_UPLOAD_MB=25
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=3600

# Keep these disabled during tools-only public launch.
ENABLE_AUTO_PUBLISH=false
ENABLE_NOTICE_CLASSIFIER=false
ENABLE_FIELD_CANDIDATES=false
ENABLE_SOURCE_HEALTH=false
