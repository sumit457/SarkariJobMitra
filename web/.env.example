DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
REDIS_URL=redis://localhost:6379

# Optional: storage (recommended for production)
PDF_STORAGE_MODE=local
PDF_STORAGE_DIR=./storage/pdfs

# Scheduler/worker
INGEST_CONCURRENCY=3
REQUEST_TIMEOUT_MS=25000
INGEST_RETRY_ATTEMPTS=2
# Optional per-group timeout overrides for slow sources
INGEST_TIMEOUT_SSC_MS=60000
INGEST_TIMEOUT_UPSC_MS=60000
INGEST_TIMEOUT_INDIAPOST_MS=45000
USER_AGENT="GovJobsBot/1.0 (+contact@example.com)"
RATE_LIMIT_MS=800

# Optional fallback if a page renders empty HTML through basic HTTP fetch
PLAYWRIGHT_FALLBACK=false

# Optional LLM-first PDF extraction via local Ollama (regex remains fallback)
LLM_EXTRACTOR_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_EXTRACTOR_MODEL=qwen2.5:7b
LLM_EXTRACTOR_TIMEOUT_MS=120000
LLM_EXTRACTOR_MAX_CHARS=24000

# Verification and coverage gates
ENABLE_NOTICE_CLASSIFIER=true
ENABLE_FIELD_CANDIDATES=true
ENABLE_AUTO_PUBLISH=false
ENABLE_SOURCE_HEALTH=true

# Existing frontend backend base
NEXT_PUBLIC_API_BASE=http://localhost:8000
