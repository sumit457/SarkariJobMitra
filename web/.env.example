DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
REDIS_URL=redis://localhost:6379

# Optional: storage (recommended for production)
PDF_STORAGE_MODE=local
PDF_STORAGE_DIR=./storage/pdfs

# Scheduler/worker
INGEST_CONCURRENCY=3
REQUEST_TIMEOUT_MS=25000
INGEST_RETRY_ATTEMPTS=2
# Optional per-group timeout overrides for slow sources
INGEST_TIMEOUT_SSC_MS=60000
INGEST_TIMEOUT_UPSC_MS=60000
INGEST_TIMEOUT_INDIAPOST_MS=45000
USER_AGENT="GovJobsBot/1.0 (+contact@example.com)"
RATE_LIMIT_MS=800

# Optional fallback if a page renders empty HTML through basic HTTP fetch
PLAYWRIGHT_FALLBACK=false

# Optional authenticated source access.
# Do not commit real credentials. Put real values only in .env.local or a secret manager.
# Replace EXAMPLE_SOURCE with the uppercased source key, non-alphanumeric chars as underscores.
# INGEST_AUTH_EXAMPLE_SOURCE_LOGIN_URL=https://official-site.gov.in/login
# INGEST_AUTH_EXAMPLE_SOURCE_USERNAME=
# INGEST_AUTH_EXAMPLE_SOURCE_PASSWORD=
# INGEST_AUTH_EXAMPLE_SOURCE_USERNAME_SELECTOR=input[name="username"]
# INGEST_AUTH_EXAMPLE_SOURCE_PASSWORD_SELECTOR=input[type="password"]
# INGEST_AUTH_EXAMPLE_SOURCE_SUBMIT_SELECTOR=button[type="submit"]
# INGEST_AUTH_EXAMPLE_SOURCE_SUCCESS_SELECTOR=.dashboard
# INGEST_AUTH_EXAMPLE_SOURCE_STORAGE_STATE=.auth/example_source.json

# Optional LLM-first PDF extraction via local Ollama (regex remains fallback)
LLM_EXTRACTOR_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:7b is the lightweight default. For better extraction accuracy try:
# - qwen3:14b or qwen3:30b if your machine can handle it
# - gemma3:12b for long-context, multilingual structured extraction
# - llama3.1:8b as a stable structured-output baseline
LLM_EXTRACTOR_MODEL=qwen2.5:7b
LLM_EXTRACTOR_TIMEOUT_MS=120000
LLM_EXTRACTOR_MAX_CHARS=24000
LLM_EXTRACTOR_NUM_CTX=32768
LLM_EXTRACTOR_USE_SCHEMA=true

# Verification and coverage gates
ENABLE_NOTICE_CLASSIFIER=true
ENABLE_FIELD_CANDIDATES=true
ENABLE_AUTO_PUBLISH=false
ENABLE_SOURCE_HEALTH=true

# Existing frontend backend base
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_PHASE=tools

# Optional production values:
# NEXT_PUBLIC_API_BASE=https://your-render-api.onrender.com
# NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
